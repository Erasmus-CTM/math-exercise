{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CTM_LIBS_EXTENSION": "${workspaceFolder}/_extensions/Erasmus-CTM/ctm-libs",
          "CTM_COMPONENT_DEV": "1",
          "JSXGRAPH_EXTENSION": "${workspaceFolder}/_extensions/jsxgraph/jsxgraph"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Render examples and run tests",
      "type": "shell",
      "command": "quarto render && npm test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CTM_LIBS_EXTENSION": "${workspaceFolder}/_extensions/Erasmus-CTM/ctm-libs",
          "CTM_COMPONENT_DEV": "1",
          "JSXGRAPH_EXTENSION": "${workspaceFolder}/_extensions/jsxgraph/jsxgraph"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
